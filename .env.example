# Supabase — projeto público (URL e anon key são seguros no navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp da loja (formato internacional, só dígitos, ex: 5515999998888)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# NUNCA prefixar com NEXT_PUBLIC_. Usada apenas em scripts administrativos
# de servidor (nunca em Server Components, Server Actions ou rotas públicas).
# SUPABASE_SERVICE_ROLE_KEY=

# Código de convite exigido em /admin/signup. Sem ele, ninguém consegue criar
# conta. Troque por outro valor quando quiser encerrar o cadastro.
ADMIN_SIGNUP_CODE=
