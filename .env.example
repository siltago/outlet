# Supabase — projeto público (URL e anon key são seguros no navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp da loja (formato internacional, só dígitos, ex: 5515999998888)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Domínio público do site (sem barra no final) — usado para montar links
# absolutos, ex: o link do produto anexado na mensagem do WhatsApp.
NEXT_PUBLIC_SITE_URL=

# NUNCA prefixar com NEXT_PUBLIC_. Usada só em código de servidor da área
# /admin/equipe e do convite (criar contas de novos admins). Nunca vai ao navegador.
SUPABASE_SERVICE_ROLE_KEY=
